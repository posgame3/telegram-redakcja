# Lokalnie
PORT=4173
HOST=127.0.0.1
AUTO_SYNC=true
SYNC_INTERVAL_MINUTES=15
# Baza danych: odrębny projekt Supabase "Nieczekai" (nie ten sam co haloAgent).
# SUPABASE_SECRET_KEY to klucz service_role/secret — pełny dostęp z pominięciem RLS.
# Nigdy nie używać klucza publishable/anon tutaj.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Model OpenAI-compatible — oba pola są wymagane do automatycznego tworzenia treści
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Tryb publiczny / reverse proxy HTTPS. Aplikacja nie może być wystawiona bezpośrednio do Internetu.
# TRUSTED_PROXY_IPS musi zawierać wyłącznie bezpośrednie adresy nginx/Caddy/load balancera.
ADMIN_USER=redakcja
ADMIN_PASSWORD=
ALLOWED_HOSTS=example.com,www.example.com
TRUST_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
