{
  "name": "telegram-redakcja-demo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Trwały pipeline agregacji wiadomości, panel redakcyjny i publiczny feed PWA z wieloźródłową syntezą AI.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --test tests/aggregator.test.mjs tests/generator.test.mjs tests/scraper.test.mjs tests/feed.test.mjs",
    "test:web": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@supabase/supabase-js": "^2.112.4",
    "cheerio": "1.2.0",
    "jsdom": "29.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "3.0.1",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
